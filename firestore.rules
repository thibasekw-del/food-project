rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collection}/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == userId
                          && collection in ['history', 'favorites', 'profile'];
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && collection in ['history', 'favorites', 'profile']
                            && request.resource.data.keys().hasOnly(['payload', 'saved_at'])
                            && request.resource.data.payload is string
                            && request.resource.data.payload.size() < 100000
                            && request.resource.data.saved_at is int;
    }
  }
}
